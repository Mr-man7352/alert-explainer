# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"                                  (JWT_SECRET)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     (FERNET_KEY)

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=alert_explainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alert_explainer
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://alert_explainer:change-me@localhost:5432/alert_explainer

# --- API security (Day 11) ---
JWT_SECRET=replace-with-32-byte-random-string
JWT_ISSUER=alert-explainer
JWT_AUDIENCE=alert-explainer-ui
FERNET_KEY=replace-with-fernet-key

# --- LLM (Day 8) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Optional path overrides ---
# AE_DATA_DIR=data
# AE_MODELS_DIR=models
# AE_REPORTS_DIR=reports
